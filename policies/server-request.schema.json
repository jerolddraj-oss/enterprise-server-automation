{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/server-request.schema.json",
  "title": "ServerProvisioningRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "hostname",
    "os_type",
    "environment",
    "cpu",
    "memory_gb",
    "owner",
    "network_zone",
    "approval_status"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{3,80}$"
    },
    "hostname": {
      "type": "string",
      "minLength": 1,
      "maxLength": 15,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*[A-Za-z0-9]$"
    },
    "os_type": {
      "enum": [
        "windows",
        "linux"
      ]
    },
    "environment": {
      "enum": [
        "development",
        "test",
        "uat",
        "production"
      ]
    },
    "cpu": {
      "type": "integer",
      "minimum": 1,
      "maximum": 128
    },
    "memory_gb": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2048
    },
    "disk_gb": {
      "type": "integer",
      "minimum": 20,
      "maximum": 65536,
      "default": 80
    },
    "owner": {
      "type": "string",
      "minLength": 2,
      "maxLength": 120
    },
    "application": {
      "type": "string",
      "maxLength": 120
    },
    "network_zone": {
      "enum": [
        "web",
        "app",
        "data",
        "management",
        "restricted"
      ]
    },
    "domain_join": {
      "type": "boolean",
      "default": false
    },
    "domain_ou": {
      "type": "string",
      "maxLength": 512
    },
    "patch_group": {
      "type": "string",
      "maxLength": 120
    },
    "backup_policy": {
      "type": "string",
      "maxLength": 120
    },
    "monitoring_policy": {
      "type": "string",
      "maxLength": 120
    },
    "approval_status": {
      "enum": [
        "approved",
        "pending",
        "rejected"
      ]
    },
    "change_id": {
      "type": "string",
      "maxLength": 80
    },
    "platform": {
      "enum": [
        "vmware",
        "scvmm",
        "hyperv",
        "azure",
        "baremetal"
      ]
    },
    "metadata": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "domain_join": {
            "const": true
          }
        },
        "required": [
          "domain_join"
        ]
      },
      "then": {
        "required": [
          "domain_ou"
        ]
      }
    }
  ]
}
